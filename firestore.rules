rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isGlaucoMember() {
      return request.auth != null
        && request.auth.uid in [
          '4ct4jQf9cPhbzqiasFT56Mav7Ds1'
        ];
    }
    match /glauco/shared/{document=**} {
      allow read, write: if isGlaucoMember();
    }
  }
}

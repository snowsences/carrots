{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glauco.local/import-schema-v6",
  "title": "Glauco guidebook file",
  "type": "object",
  "required": [
    "format",
    "version",
    "trips"
  ],
  "properties": {
    "format": {
      "const": "glauco-trip-file"
    },
    "version": {
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "description": "Use version 6 for standalone wildlife field guides. Destination guides use version 5 or 6. Existing dated trip files remain accepted without changes."
    },
    "trips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/trip"
          },
          {
            "$ref": "#/$defs/destinationGuide"
          },
          {
            "$ref": "#/$defs/wildlifeGuide"
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2000
    },
    "optionalUrl": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/$defs/url"
        }
      ]
    },
    "photo": {
      "type": "object",
      "properties": {
        "url": {
          "$ref": "#/$defs/url"
        },
        "thumbnailUrl": {
          "$ref": "#/$defs/url"
        },
        "caption": {
          "type": "string",
          "maxLength": 500
        },
        "creator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "licenseUrl": {
          "$ref": "#/$defs/optionalUrl"
        },
        "sourceUrl": {
          "$ref": "#/$defs/url"
        }
      },
      "required": [
        "url",
        "thumbnailUrl",
        "caption",
        "creator",
        "license",
        "licenseUrl",
        "sourceUrl"
      ],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 350
        }
      },
      "required": [
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          }
        }
      },
      "required": [
        "heading",
        "paragraphs"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "url": {
          "$ref": "#/$defs/url"
        }
      },
      "required": [
        "title",
        "url"
      ],
      "additionalProperties": false
    },
    "attraction": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "location": {
          "type": "string",
          "maxLength": 250
        },
        "visitTime": {
          "type": "string",
          "maxLength": 40
        },
        "summary": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "facts": {
          "type": "array",
          "maxItems": 15,
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "sections": {
          "type": "array",
          "maxItems": 15,
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "wikipediaUrl": {
          "$ref": "#/$defs/optionalUrl"
        },
        "sources": {
          "type": "array",
          "maxItems": 15,
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "researchedAt": {
          "$ref": "#/$defs/date"
        },
        "photos": {
          "type": "array",
          "maxItems": 12,
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/photo"
          }
        },
        "notice": {
          "description": "Exactly three brief, specific things to notice on site. Omit or use [] if unavailable.",
          "type": "array",
          "maxItems": 3,
          "anyOf": [
            {
              "maxItems": 0
            },
            {
              "minItems": 3
            }
          ],
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "comparisons": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/comparison"
          },
          "description": "Optional. Keep only substantive historical, religious, architectural, or material connections to earlier stops. Omit rather than manufacture an analogy."
        },
        "history": {
          "type": "array",
          "maxItems": 8,
          "description": "Optional chronological milestones. Omit when a reliable date or an interesting development is unavailable.",
          "items": {
            "$ref": "#/$defs/historyEvent"
          }
        },
        "originality": {
          "type": "array",
          "maxItems": 4,
          "description": "Optional concise, specific notes distinguishing original fabric, later historical alterations, and modern reconstruction. Include only information that helps visitors understand what they can see. No generic conservation filler.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1800
          }
        },
        "neighborhood": {
          "type": "string",
          "maxLength": 180,
          "description": "Optional neighborhood or district for a destination-guide attraction."
        },
        "category": {
          "type": "string",
          "enum": ["attraction", "dining", "neighborhood"],
          "description": "Optional category for Place browsing tabs. Defaults to attraction for existing files."
        }
      },
      "required": [
        "id",
        "name",
        "location",
        "summary",
        "facts",
        "sections",
        "wikipediaUrl",
        "sources",
        "researchedAt",
        "photos"
      ],
      "additionalProperties": false
    },
    "day": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "attractions": {
          "type": "array",
          "maxItems": 100,
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/attraction"
          }
        }
      },
      "required": [
        "id",
        "date",
        "title",
        "attractions"
      ],
      "additionalProperties": false
    },
    "trip": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2200
        },
        "startDate": {
          "$ref": "#/$defs/date"
        },
        "endDate": {
          "$ref": "#/$defs/date"
        },
        "coverUrl": {
          "$ref": "#/$defs/optionalUrl"
        },
        "headerUrl": {
          "$ref": "#/$defs/optionalUrl",
          "description": "Optional dedicated image for the fixed Trip Details header. Existing trip files can omit it."
        },
        "days": {
          "type": "array",
          "maxItems": 120,
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/day"
          }
        },
        "glossary": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "$ref": "#/$defs/glossaryTerm"
          }
        },
        "wildlife": {
          "$ref": "#/$defs/wildlife",
          "description": "Optional offline field guide. Store each species once, with multiple where entries. Area IDs and attraction links must resolve within the trip."
        },
        "customs": {
          "$ref": "#/$defs/customs"
        }
      },
      "required": [
        "id",
        "name",
        "year",
        "startDate",
        "endDate",
        "coverUrl",
        "days"
      ],
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "description": "Relate the current site to an attraction visited earlier in this itinerary. Never discuss future attractions. The app checks attractionId against itinerary order.",
      "properties": {
        "attractionId": {
          "$ref": "#/$defs/id"
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1800
          }
        }
      },
      "required": [
        "attractionId",
        "paragraphs"
      ],
      "additionalProperties": false
    },
    "glossaryTerm": {
      "type": "object",
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "aliases": {
          "type": "array",
          "maxItems": 8,
          "description": "Optional exact alternative spellings, singular/plural forms, or shorter names to make tappable in guide prose. All terms and aliases must be unique, ignoring case.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "photo": {
          "type": "object",
          "description": "Optional public reference image that makes this term easier to recognise. Include it only when the image clearly illustrates the term.",
          "properties": {
            "url": { "$ref": "#/$defs/imageUrl" },
            "thumbnailUrl": { "$ref": "#/$defs/imageUrl" },
            "alt": { "type": "string", "maxLength": 250 }
          },
          "required": ["url"],
          "additionalProperties": false
        }
      },
      "required": [
        "term",
        "definition"
      ],
      "additionalProperties": false
    },
    "historyEvent": {
      "type": "object",
      "description": "A meaningful, sourced milestone for this site. year is a chronological sorting anchor; label expresses the actual precision, such as Late 12th century. Do not turn an approximate period into a claimed exact year.",
      "properties": {
        "year": {
          "type": "integer",
          "minimum": -10000,
          "maximum": 2200
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "text": {
          "type": "string",
          "maxLength": 1200
        }
      },
      "required": [
        "year",
        "label",
        "title",
        "text"
      ],
      "additionalProperties": false
    },
    "wildlifeArea": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 600
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "wildlifeWhere": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "areaId": {
          "$ref": "#/$defs/id"
        },
        "likelihood": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "attractionIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 30,
          "uniqueItems": true
        }
      },
      "required": [
        "areaId",
        "likelihood",
        "note"
      ]
    },
    "lookalike": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "distinction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "required": [
        "name",
        "distinction"
      ]
    },
    "species": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "flora",
            "fauna"
          ]
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "scientificName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "maxItems": 12
        },
        "status": {
          "type": "string",
          "maxLength": 250
        },
        "identification": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "maxItems": 8,
          "minItems": 1
        },
        "lookalikes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lookalike"
          },
          "maxItems": 6
        },
        "summary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "maxItems": 6,
          "minItems": 1
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          },
          "maxItems": 12
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          },
          "maxItems": 10
        },
        "where": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wildlifeWhere"
          },
          "maxItems": 20
        },
        "photos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/photo"
          },
          "maxItems": 12
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "maxItems": 15
        },
        "researchedAt": {
          "$ref": "#/$defs/date"
        },
        "taxonIds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inaturalist": {
              "$ref": "#/$defs/id"
            },
            "gbif": {
              "$ref": "#/$defs/id"
            },
            "ebird": {
              "$ref": "#/$defs/id"
            }
          },
          "required": []
        },
        "areaIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 20,
          "uniqueItems": true
        },
        "wikipediaUrl": {
          "$ref": "#/$defs/optionalUrl"
        }
      },
      "required": [
        "id",
        "kind",
        "group",
        "name",
        "scientificName",
        "identification",
        "summary"
      ]
    },
    "wildlife": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "areas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wildlifeArea"
          },
          "maxItems": 20
        },
        "species": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/species"
          },
          "maxItems": 600
        },
        "browseByArea": {
          "type": "boolean",
          "description": "Show region cards first, with Plants, Birds and Other animals within each region. Each species needs matching areaIds."
        }
      },
      "required": [
        "areas",
        "species"
      ]
    },
    "customs": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional local customs and language guides, saved and downloaded with this guidebook. A nonempty guides list replaces bundled customs. Omit or use an empty guides list for the bundled fallback. Maximum 100 KiB normalized content in total.",
      "properties": {
        "guides": {
          "type": "array",
          "maxItems": 12,
          "items": {"$ref": "#/$defs/customsGuide"}
        }
      },
      "required": ["guides"]
    },
    "customsGuide": {
      "type": "object",
      "additionalProperties": false,
      "description": "A country, region or language guide. IDs must be unique within customs.guides. Needs at least one section or phrase and can contain at most 50 KiB after normalization.",
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "intro": {"type": "string", "maxLength": 1200},
        "sections": {
          "type": "array", "maxItems": 15,
          "items": {"$ref": "#/$defs/customsSection"}
        },
        "language": {"type": "string", "maxLength": 80},
        "lang": {
          "type": "string", "maxLength": 35,
          "pattern": "^(?:[a-zA-Z]{2,8}(?:-[a-zA-Z0-9]{1,8})*)?$",
          "description": "Language tag for the local phrase text, such as it, es or pt-BR. Required and nonempty when phrases are included."
        },
        "phraseNote": {"type": "string", "maxLength": 1200},
        "phrases": {
          "type": "array", "maxItems": 40,
          "items": {"$ref": "#/$defs/customsPhrase"}
        },
        "sources": {
          "type": "array", "maxItems": 15,
          "items": {"$ref": "#/$defs/source"}
        },
        "researchedAt": {"$ref": "#/$defs/date"}
      },
      "required": ["id", "name", "researchedAt"],
      "anyOf": [
        {"required": ["sections"], "properties": {"sections": {"minItems": 1}}},
        {"required": ["phrases"], "properties": {"phrases": {"minItems": 1}}}
      ],
      "allOf": [{
        "if": {"required": ["phrases"], "properties": {"phrases": {"minItems": 1}}},
        "then": {"required": ["language", "lang"], "properties": {"language": {"minLength": 1}, "lang": {"minLength": 1}}}
      }]
    },
    "customsSection": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "heading": {"type": "string", "minLength": 1, "maxLength": 120},
        "paragraphs": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {"type": "string", "minLength": 1, "maxLength": 3000}
        }
      },
      "required": ["heading", "paragraphs"]
    },
    "customsPhrase": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "meaning": {"type": "string", "minLength": 1, "maxLength": 180},
        "native": {"type": "string", "minLength": 1, "maxLength": 250},
        "pronunciation": {"type": "string", "maxLength": 250}
      },
      "required": ["meaning", "native"]
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "description": "Place name, such as Venice, Florence or Rome."
        },
        "attractions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/attraction"
          }
        }
      },
      "required": [
        "id",
        "title",
        "attractions"
      ]
    },
    "wildlifeGuide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "guideType": { "const": "wildlife" },
        "coverUrl": { "$ref": "#/$defs/optionalUrl" },
        "headerUrl": { "$ref": "#/$defs/optionalUrl" },
        "glossary": {
          "type": "array",
          "maxItems": 60,
          "items": { "$ref": "#/$defs/glossaryTerm" }
        },
        "wildlife": { "$ref": "#/$defs/wildlife" }
      },
      "required": ["id", "name", "guideType", "coverUrl", "wildlife"]
    },
    "destinationGuide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "guideType": {
          "const": "destination"
        },
        "coverUrl": {
          "$ref": "#/$defs/optionalUrl"
        },
        "places": {
          "type": "array",
          "minItems": 1,
          "maxItems": 120,
          "items": {
            "$ref": "#/$defs/place"
          }
        },
        "glossary": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "$ref": "#/$defs/glossaryTerm"
          }
        },
        "wildlife": {
          "$ref": "#/$defs/wildlife",
          "description": "Optional offline field guide for the destination."
        },
        "customs": {
          "$ref": "#/$defs/customs"
        }
      },
      "required": [
        "id",
        "name",
        "guideType",
        "coverUrl",
        "places"
      ]
    }
  }
}
